# Plantilla del env del puente (Telegram ↔ OpenCode) — copiar a
# ~/.config/opencode/telegram.env y completar. Los valores NUNCA se suben:
# este archivo es solo la forma del env. Comandos equivalentes en el puente:
# /ayuda /proyectos /proyecto /nueva /estado /si /no /start

# --- obligatorio (sin ellos el puente NO arranca: fail-closed) ---------------
# Token del bot de @BotFather
TELEGRAM_BOT_TOKEN=
# Tu chat de Telegram: solo ese chat puede usar el bot
TELEGRAM_CHAT_ID=

# --- modelos (OPCIONAL) ------------------------------------------------------
# El puente elige audio e imagen contra el CATÁLOGO de modelos que reporta el
# servidor de OpenCode (c.model.list), con la política:
#   1) el preferido (esto), si el catálogo lo lista con la capacidad;
#   2) modelos de costo 0 (gratuitos) con la capacidad;
#   3) los de tu conexión propia de Google (console-google) si hicieran falta.
# Un modelo de pago de otros proveedores NUNCA se elige en automático.
# Si el preferido desaparece del catálogo o falla el cambio de modelo, el puente
# sigue con el siguiente candidato y te avisa — el mensaje no se pierde.
#
# Orden de modelos PARA IMAGEN (vacío = el default de abajo):
MODELO_ADJUNTOS=console-google/gemini-3.8-flash
# Prioridad manual PARA VOZ (vacío = gratis primero, hoy mimo-v2.6-flash-free):
MODELO_AUDIO=

# --- respaldo local de voz (whisper.cpp), opcional ---------------------------
# Se usa solo si ningún candidato de audio del catálogo responde.
# WHISPER_BIN=/home/dozelix/.local/bin/whisper-cli
# WHISPER_MODEL=/home/dozelix/.local/share/whisper/models/ggml-base.bin
# VOZ_IDIOMA=es

# --- otros (no tocar sin razón) ----------------------------------------------
# AGENTE=saulo                      # agente por defecto de las sesiones
# OPENCODE_URL=http://127.0.0.1:4096  # respaldo si el registro del servicio falta
